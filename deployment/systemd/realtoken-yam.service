[Unit]
Description=RealToken YAM Interface Next.js Application
After=network.target

[Service]
Type=simple
# Change 'www-data' to your Linux username (run 'whoami' to find it)
User=root
# Change this to the full path where you cloned the repository
# Example: /home/username/realtoken-yam-interface or /var/www/realtoken-yam-interface
WorkingDirectory=/root/realtoken-yam-interface
Environment=NODE_ENV=production
Environment=PORT=3000
# Use 'which npm' to find the correct path, common paths:
# - /usr/bin/npm (if installed via package manager)
# - /usr/local/bin/npm (if installed via nvm or manual install)
# - /home/username/.nvm/versions/node/v20.x.x/bin/npm (if using nvm)
ExecStart=/root/.nvm/versions/node/v24.12.0/bin/npm start
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=realtoken-yam

# Security settings
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

