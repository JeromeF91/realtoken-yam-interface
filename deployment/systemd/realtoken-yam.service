[Unit]
Description=RealToken YAM Interface Next.js Application
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/path/to/realtoken-yam-interface
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=realtoken-yam

# Security settings
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

